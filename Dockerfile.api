############################################################
# Fleet Route Optimizer - API Server (Production Image)
############################################################

# ---------- Build Stage (installs dev deps & compiles) ----------
FROM node:20-alpine AS build
WORKDIR /app
RUN apk add --no-cache python3 make g++
COPY package*.json ./
RUN npm install
COPY tsconfig.* ./
COPY src ./src
COPY fleet-optimizer-postgres.html ./
RUN npm run build:api

# ---------- Runtime Stage (lean production image) ----------
FROM node:20-alpine AS runtime
WORKDIR /app
RUN apk add --no-cache curl
COPY package*.json ./
# Install only production deps for smaller image
RUN npm install --omit=dev

# Copy compiled dist and static asset
COPY --from=build /app/dist ./dist
RUN mkdir -p public
COPY fleet-optimizer-postgres.html public/index.html

ENV NODE_ENV=production
EXPOSE 3001 3002

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:3001/health || exit 1

CMD ["node", "dist/api/server.js"]